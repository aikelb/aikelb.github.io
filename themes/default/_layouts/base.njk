<!DOCTYPE html>
<html lang="{{ locales[page.lang].locale or page.lang }}" dir="{{ locales[page.lang].dir or 'ltr' }}" x-data :data-theme="$store.elva.theme">
    <head>
        {%- set t = ((seo.title or title) + ' ' + settings.meta.separator + ' ' + ('meta.title' | translate) if (seo.title or title) else ('meta.title' | translate)) %}
        {%- set d = (seo.description | striptags | truncate(140, false, '…')) or ('meta.description' | translate) %}
        {%- set u = page.url | htmlBaseUrl(settings.url) %}
        {%- set i = (thumbnail or settings.meta.opengraphDefaultImage) | htmlBaseUrl(settings.url) %}
        {%- set ia = thumbnailDescription or ('meta.opengraphDefaultAlt' | translate) %}
        {%- set ta = tags or [] %}

        <!-- charset / viewport -->
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <!-- title / description -->
        <title>{{ t }}</title>
		<meta name="description" content="{{ d }}">

        <!-- canonical / alternates -->
        <link rel="canonical" href="{{ u }}">
        <link rel="alternate" hreflang="{{ page.lang }}" href="{{ u }}">
        {% for link in page.url | locale_links | fix_locale_links %}<link rel="alternate" hreflang="{{ link.lang }}" href="{{ settings.url }}{{ link.url }}">{% endfor %}

        <!-- open graph -->
        <meta property="og:site_name" content="{{ 'meta.title' | translate }}">
        <meta property="og:title" content="{{ t }}">
        <meta property="og:description" content="{{ d }}">
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ u }}">
        <meta property="og:logo" content="{{ "/assets/img/icon-192.png" | htmlBaseUrl(settings.url) | cdnify }}">
        <meta property="og:image" content="{{ i | cdnify }}">
        <meta property="og:image:alt" content="{{ ia }}">
        <meta property="og:locale" content="{{ locales[page.lang].locale or page.lang }}">

        <!-- icons -->
        <link rel="icon" href="{{ "/favicon.ico" | htmlBaseUrl(settings.url) }}" sizes="any">
        <link rel="icon" href="{{ "/assets/img/icon.svg" | htmlBaseUrl(settings.url) }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ "/assets/img/icon-180.png" | htmlBaseUrl(settings.url) | cdnify }}">

        <!-- styles -->
        {% css %}{% include '../css/reset.css' %}{% endcss -%}
        {% css %}{% include '../css/variables.css' %}{% endcss -%}
        {% css 'main' %}{% include '../css/redesign.css' %}{% endcss -%}
        {% css 'defer' %}{% include '../css/defer.css' %}{% endcss -%}
        {% css 'defer' %}{% include '../css/components/syntax.css' %}{% endcss -%}
	    <style>{% getBundle 'css' %}</style>
	    <link rel="stylesheet" href="{% getBundleFileUrl 'css', 'main' %}?v={% version %}">
	    <link rel="stylesheet" href="{% getBundleFileUrl 'css', 'defer' %}?v={% version %}" fetchpriority="low">

        <!-- feeds -->
        <link rel="alternate" href="{{ "/feed/feed.xml" | locale_url | htmlBaseUrl(settings.url) }}" type="application/atom+xml" title="{{ 'meta.rssTitle' | translate }} {{ settings.meta.separator }} {{ 'meta.title' | translate }}">
		<link rel="alternate" href="{{ "/feed/feed.json" | locale_url | htmlBaseUrl(settings.url) }}" type="application/json" title="{{ 'meta.jsonTitle' | translate }} {{ settings.meta.separator }} {{ 'meta.title' | translate }}">
        {% if blogroll | length %}<link rel="blogroll"  href="{{ "/feed/blogroll.xml" | locale_url | htmlBaseUrl(settings.url) }}" type="text/xml" title="{{ 'meta.blogrollTitle' | translate }} {{ settings.meta.separator }} {{ 'meta.title' | translate }}">{% endif %}

        <!-- fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"></noscript>

        <!-- preload / prefetch -->
        {% if (settings.isProduction or settings.isStaging) and settings.cdn %}<link rel="dns-prefetch" href="https://i0.wp.com/">{% endif %}

        <!-- everything else -->
        <meta name="generator" content="{{ eleventy.generator }}">
        <link rel="manifest" href="{{ "/site.webmanifest" | locale_url | htmlBaseUrl(settings.url) }}">
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="{{ settings.themeColorLight }}">
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="{{ settings.themeColorDark }}">
        {% if settings.isStaging or seo.noIndex %}<meta name="robots" content="noindex, nofollow">{% endif %}
        {% if settings.author.githubProfile %}<link rel="me" href="{{ settings.author.githubProfile }}">{% endif %}
        {% if settings.author.fediverseProfile %}<link rel="me" href="{{ settings.author.fediverseProfile }}">{% endif %}
        {% if settings.author.fediverseUsername %}<meta name="fediverse:creator" content="{{ settings.author.fediverseUsername }}">{% endif %}

        <!-- set theme before page renders to stop fouc -->
        {% js %}document.documentElement.classList.add('js');document.documentElement.dataset.theme = localStorage.getItem('theme') === null ? window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light' : localStorage.getItem('theme'){% endjs %}
        
        <!-- inline scripts -->
        <script>{% getBundle 'js' %}</script>
    </head>

    <body class="{% set space = joiner(" ") -%}{% for tag in ta -%}{{ space() }}{{ tag | slugify }}{% endfor -%}">

        <a class="skip-link" href="#main">Skip to content</a>

        <!-- Drifting dot-field background -->
        <canvas class="bg-dots" aria-hidden="true"></canvas>

        <!-- Sticky Topbar Header -->
        <header class="header">
            <div class="header-inner">
                <a href="/" class="header-branding">Aitor Lozano</a>
                <nav class="header-nav">
                    <a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Work</a>
                    <a href="/writing/" {% if page.url == '/writing/' %}aria-current="page"{% endif %}>Notes</a>
                    <a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a>
                </nav>
                <!-- Theme toggle + dot-field toolbox grouped together -->
                <div class="header-actions">
                    <button class="theme-toggle" @click="$store.elva.themeToggle()" :aria-label="$store.elva.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'">
                        <svg class="theme-toggle-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                        <svg class="theme-toggle-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    </button>
                    <div x-data="toolbox" class="toolbox-wrapper" x-effect="sync()" @click.outside="open = false" @keydown.escape.window="open = false">
                        <button type="button" class="theme-toggle toolbox-btn" @click="open = !open" :class="{ 'is-active': open }" :aria-expanded="open.toString()" aria-label="Dot field settings">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                                <circle cx="2.5" cy="2.5" r="1.5"/><circle cx="9.5" cy="2.5" r="1.5"/>
                                <circle cx="2.5" cy="9.5" r="1.5"/><circle cx="9.5" cy="9.5" r="1.5"/>
                            </svg>
                        </button>
                        <div class="toolbox-panel" :class="{ 'is-open': open }">
                            <div class="toolbox-header">
                                <span class="toolbox-title">[dot field]</span>
                                <button type="button" class="toolbox-reset" @click="reset()">reset</button>
                            </div>
                            <div class="toolbox-rows">
                                <label class="toolbox-row">
                                    <span class="toolbox-label">density<span class="toolbox-val" x-text="spacing"></span></span>
                                    <input type="range" class="toolbox-slider" min="16" max="60" step="4" x-model="spacing">
                                </label>
                                <label class="toolbox-row">
                                    <span class="toolbox-label">fade<span class="toolbox-val" x-text="Math.round(minFade * 100) + '%'"></span></span>
                                    <input type="range" class="toolbox-slider" min="0" max="1" step="0.05" x-model="minFade">
                                </label>
                                <label class="toolbox-row">
                                    <span class="toolbox-label">parallax<span class="toolbox-val" x-text="Math.round(parallax * 100)"></span></span>
                                    <input type="range" class="toolbox-slider" min="0" max="0.8" step="0.05" x-model="parallax">
                                </label>
                                <label class="toolbox-row">
                                    <span class="toolbox-label">intensity<span class="toolbox-val" x-text="intensity.toFixed(1)"></span></span>
                                    <input type="range" class="toolbox-slider" min="0.1" max="5" step="0.1" x-model="intensity">
                                </label>
                                <label class="toolbox-row">
                                    <span class="toolbox-label">attraction<span class="toolbox-val" x-text="pointerStrength.toFixed(1)"></span></span>
                                    <input type="range" class="toolbox-slider" min="0" max="3" step="0.1" x-model="pointerStrength">
                                </label>
                                <div class="toolbox-row toolbox-row--opts">
                                    <span class="toolbox-label">pattern</span>
                                    <div class="toolbox-opts">
                                        <button type="button" class="toolbox-opt" :class="{ 'is-active': pattern === 'grid' }" @click="pattern = 'grid'">grid</button>
                                        <button type="button" class="toolbox-opt" :class="{ 'is-active': pattern === 'hex' }" @click="pattern = 'hex'">hex</button>
                                    </div>
                                </div>
                                <label class="toolbox-row">
                                    <span class="toolbox-label">jitter<span class="toolbox-val" x-text="Math.round(jitter * 100) + '%'"></span></span>
                                    <input type="range" class="toolbox-slider" min="0" max="1" step="0.05" x-model="jitter">
                                </label>
                                <label class="toolbox-row">
                                    <span class="toolbox-label">wave dir<span class="toolbox-val" x-text="waveAngle + '°'"></span></span>
                                    <input type="range" class="toolbox-slider" min="0" max="355" step="5" x-model="waveAngle">
                                </label>
                                <label class="toolbox-row">
                                    <span class="toolbox-label">wave speed<span class="toolbox-val" x-text="(speed * 1000).toFixed(0)"></span></span>
                                    <input type="range" class="toolbox-slider" min="0" max="0.1" step="0.002" x-model="speed">
                                </label>
                                <div class="toolbox-row toolbox-row--color">
                                    <span class="toolbox-label">color</span>
                                    <input type="color" class="toolbox-color" x-model="color">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content" id="main">
            {{ content | safe }}
        </main>

        <!-- Footer -->
        {% include "footer.njk" %}

        <!-- scripts -->
        {% js 'defer' %}{% include '../../../node_modules/alpinejs/dist/cdn.js' %}{% endjs -%}
        {% js 'defer' %}{% include '../../../node_modules/@alpinejs/intersect/dist/cdn.js' %}{% endjs -%}
        {% js 'defer' %}{% include '../js/background.js' %}{% endjs -%}
        {% js 'defer' %}{% include '../js/gamefeel.js' %}{% endjs -%}
        {% js 'defer' %}{% include '../js/v60-recipes.cjs' %}{% endjs -%}
        {% js 'defer' %}{% include '../js/scripts.js' %}{% endjs -%}
        <script src="{% getBundleFileUrl 'js', 'defer' %}?v={% version %}" defer></script>


    </body>
</html>
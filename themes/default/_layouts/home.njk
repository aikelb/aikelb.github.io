<!-- Floating constellation -->
<script>
(function() {
    var canvas = document.getElementById('hero-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var stars = [];
    var animId;
    var time = 0;

    function resize() {
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
    }

    function createStars() {
        var count = Math.min(90, Math.floor(canvas.width / 12));
        stars = [];
        for (var i = 0; i < count; i++) {
            var baseX = Math.random();
            var baseY = Math.random();
            stars.push({
                bx: baseX,       // base position (normalized 0-1)
                by: baseY,
                ox: (Math.random() - 0.5) * 0.015,  // orbit speed x
                oy: (Math.random() - 0.5) * 0.015,  // orbit speed y
                phase: Math.random() * Math.PI * 2,  // orbit phase offset
                radius: Math.random() * 0.008 + 0.002, // orbit radius (normalized)
                size: Math.random() < 0.12 ? (Math.random() * 1.5 + 1.5) : (Math.random() * 1 + 0.4), // few bright, most dim
                brightness: Math.random() * 0.3 + 0.2,
                pulseSpeed: Math.random() * 0.015 + 0.005,
                hue: Math.random() < 0.2 ? 'cyan' : 'blue', // occasional cyan accent
            });
        }
    }

    function draw() {
        time += 0.008;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        var w = canvas.width;
        var h = canvas.height;

        // Update and draw stars
        for (var i = 0; i < stars.length; i++) {
            var s = stars[i];
            // Orbital motion around base position
            var angle = time * 0.5 + s.phase;
            var ox = Math.cos(angle * s.ox * 30) * s.radius;
            var oy = Math.sin(angle * s.oy * 30) * s.radius;
            var x = (s.bx + ox) * w;
            var y = (s.by + oy) * h;

            // Slow drift of base position
            s.bx += s.ox * 0.0003;
            s.by += s.oy * 0.0003;
            if (s.bx > 1.05) s.bx = -0.05;
            if (s.bx < -0.05) s.bx = 1.05;
            if (s.by > 1.05) s.by = -0.05;
            if (s.by < -0.05) s.by = 1.05;

            // Pulsing brightness
            var pulse = Math.sin(time * s.pulseSpeed * 20) * 0.2 + 0.8;
            var alpha = s.brightness * pulse;

            // Glow
            var gradient = ctx.createRadialGradient(x, y, 0, x, y, s.size * 3);
            var color = s.hue === 'cyan' ? '125, 207, 255' : '122, 162, 247';
            gradient.addColorStop(0, 'rgba(' + color + ', ' + (alpha * 1.2) + ')');
            gradient.addColorStop(0.5, 'rgba(' + color + ', ' + (alpha * 0.3) + ')');
            gradient.addColorStop(1, 'rgba(' + color + ', 0)');
            ctx.beginPath();
            ctx.arc(x, y, s.size * 3, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();

            // Core dot
            ctx.beginPath();
            ctx.arc(x, y, s.size * 0.4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(' + color + ', ' + Math.min(alpha * 1.5, 0.8) + ')';
            ctx.fill();
        }

        // Draw connections between nearby stars
        for (var i = 0; i < stars.length; i++) {
            var s1 = stars[i];
            var x1 = (s1.bx + Math.cos(time * 0.5 + s1.phase) * s1.radius) * w;
            var y1 = (s1.by + Math.sin(time * 0.5 + s1.phase) * s1.radius) * h;

            for (var j = i + 1; j < stars.length; j++) {
                var s2 = stars[j];
                var x2 = (s2.bx + Math.cos(time * 0.5 + s2.phase) * s2.radius) * w;
                var y2 = (s2.by + Math.sin(time * 0.5 + s2.phase) * s2.radius) * h;

                var dx = x1 - x2;
                var dy = y1 - y2;
                var dist = Math.sqrt(dx * dx + dy * dy);
                var maxDist = 150;

                if (dist < maxDist) {
                    var alpha = 0.12 * (1 - dist / maxDist);
                    ctx.beginPath();
                    ctx.moveTo(x1, y1);
                    ctx.lineTo(x2, y2);
                    ctx.strokeStyle = 'rgba(122, 162, 247, ' + alpha + ')';
                    ctx.lineWidth = 0.4;
                    ctx.stroke();
                }
            }
        }

        animId = requestAnimationFrame(draw);
    }

    resize();
    createStars();
    draw();
    window.addEventListener('resize', function() {
        resize();
        createStars();
    });
})();
</script>

<!-- Scroll reveal observer -->
<script>
(function() {
    requestAnimationFrame(function() {
        requestAnimationFrame(function() {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                    }
                });
            }, { threshold: 0 });

            document.querySelectorAll('.anim-reveal').forEach(function(el) {
                observer.observe(el);
            });
        });
    });
})();
</script>

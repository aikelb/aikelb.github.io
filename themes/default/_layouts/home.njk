---
layout: base
---

<!-- Page wrapper to enforce grid limits -->
<div class="page-container">

    <!-- Row 1: About & Experience side by side -->
    <div class="content-columns">
        <section class="section anim-reveal" id="about">
            <header class="section-header">
                <span class="section-index">[01 // about]</span>
            </header>
            <div class="about-text">
                <p>I build AI-powered developer tools and have shipped 80+ games across PC, console, VR, and mobile. I also lecture on game programming and mentor startups. Based in the Canary Islands. <a href="/about/">More about me →</a></p>
            </div>
        </section>

        <section class="section anim-reveal" id="work">
            <header class="section-header">
                <span class="section-index">[02 // experience]</span>
            </header>
            <div class="work-table">
                <div class="work-row work-row--current">
                    <span class="work-company">INNO-VERSE</span>
                    <span class="work-role">Software Engineer</span>
                    <span class="work-dates">2025 – Present</span>
                    <span class="work-detail">Building AI agents. Python, FastAPI, LangChain.</span>
                </div>
                <div class="work-row">
                    <span class="work-company">Exel by Merak</span>
                    <span class="work-role">Entrepreneur in Residence</span>
                    <span class="work-dates">2025</span>
                    <span class="work-detail">Advising gaming startups in Riyadh accelerator programs. Mentorship &amp; code reviews.</span>
                </div>
                <div class="work-row">
                    <span class="work-company">Aurita Games</span>
                    <span class="work-role">CEO &amp; Game Developer</span>
                    <span class="work-dates">2020 – 2025</span>
                    <span class="work-detail">Directed production of over 80+ web, PC, and cozy mobile game assets.</span>
                </div>
                <div class="work-row">
                    <span class="work-company">PlayMedusa</span>
                    <span class="work-role">Game Developer</span>
                    <span class="work-dates">2011 – 2025</span>
                    <span class="work-detail">14 years shipping game designs and programming services across mobile, PC, VR.</span>
                </div>
                <div class="work-row">
                    <span class="work-company">30 Parallel Games</span>
                    <span class="work-role">Senior Developer</span>
                    <span class="work-dates">2018 – 2020</span>
                    <span class="work-detail">Built real-time multiplayer VR systems and decentralized application backends.</span>
                </div>
                <div class="work-row">
                    <span class="work-company">Relativity Studios</span>
                    <span class="work-role">Lead Developer</span>
                    <span class="work-dates">2017</span>
                    <span class="work-detail">Led team of 5 on Barbie™ mobile games (surpassed 10 Million+ downloads).</span>
                </div>
            </div>
        </section>
    </div>

    <!-- Row 3: Notes -->
    <div class="content-full">
        <section class="section anim-reveal" id="notes">
            <header class="section-header">
                <span class="section-index">[03 // notes]</span>
            </header>
            <div class="posts-list">
                {%- set latestPosts = collections._posts | sortBy('date', true) %}
                {%- for post in latestPosts %}
                {%- if loop.index0 < 6 %}
                <a href="{{ post.url }}" class="post-row">
                    <span class="post-row-title">{{ post.data.title }}</span>
                    <span class="post-row-tags">
                        {%- for tag in post.data.tags | filterPrivateTags %}
                        <span class="post-row-tag">{{ tag }}</span>
                        {%- endfor %}
                    </span>
                </a>
                {%- endif %}
                {%- endfor %}
            </div>
            <a href="/writing/" class="posts-more">→ browse all notes ({{ collections._posts | languageFilter | length }})</a>
        </section>
    </div>

    <!-- Row 4: Bento Grid -->
    <div class="content-full">
        <section class="section anim-reveal" id="stats">
            <div class="bento-grid">
                <div class="bento-cell">
                    <span class="bento-number">14+</span>
                    <span class="bento-label">years coding</span>
                    <span class="bento-number" style="margin-top:var(--space-2xs)">80+</span>
                    <span class="bento-label">games published</span>
                </div>
                <div class="bento-cell bento-cell--cat bento-cell--tall">
                    <img src="/assets/img/cats.jpg" alt="Marvel &amp; Haru" loading="lazy" eleventy:ignore>
                </div>
                <div class="bento-cell">
                    <strong class="bento-cell-heading">Currently</strong>
                    <div class="bento-tags">
                        <span class="bento-tag">python</span>
                        <span class="bento-tag">fastapi</span>
                        <span class="bento-tag">langchain</span>
                        <span class="bento-tag">git</span>
                        <span class="bento-tag">picotron</span>
                    </div>
                </div>
                <div class="bento-cell">
                    <strong class="bento-cell-heading">Previously</strong>
                    <div class="bento-tags">
                        <span class="bento-tag bento-tag--muted">c#</span>
                        <span class="bento-tag bento-tag--muted">javascript</span>
                        <span class="bento-tag bento-tag--muted">node.js</span>
                        <span class="bento-tag bento-tag--muted">lua</span>
                        <span class="bento-tag bento-tag--muted">solidity</span>
                        <span class="bento-tag bento-tag--muted">hardhat</span>
                        <span class="bento-tag bento-tag--muted">unreal</span>
                        <span class="bento-tag bento-tag--muted">defold</span>
                        <span class="bento-tag bento-tag--muted">unity3d</span>
                        <span class="bento-tag bento-tag--muted">rider</span>
                    </div>
                </div>
                <div class="bento-cell">
                    <strong class="bento-cell-heading">Toolbox</strong>
                    <div class="bento-tags">
                        <span class="bento-tag">neovim</span>
                        <span class="bento-tag">ghostty</span>
                        <span class="bento-tag">obsidian</span>
                        <span class="bento-tag">omarchy</span>
                        <span class="bento-tag">osx</span>
                        <span class="bento-tag">zen</span>
                        <span class="bento-tag">gopass</span>
                        <span class="bento-tag">lazydocker</span>
                        <span class="bento-tag">lazygit</span>
                    </div>
                </div>
            </div>
        </section>
    </div>

</div>
<!-- end page-container -->

<!-- Scroll Reveals -->
<script>
(function() {
    requestAnimationFrame(function() {
        requestAnimationFrame(function() {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                    }
                });
            }, { threshold: 0.05 });

            document.querySelectorAll('.anim-reveal').forEach(function(el) {
                observer.observe(el);
            });
        });
    });
})();
</script>

---
layout: base
---

<!-- Page wrapper to enforce grid limits -->
<div class="page-container">

    <!-- Hero -->
    <div class="hero-statement">
        <h1 class="hero-headline">I build software,<br>games, and tools.</h1>
        <p class="hero-sub">that people enjoy using.</p>
        <p class="hero-note">Based in Canary Islands · Building AI products · 2025</p>
    </div>

    <!-- Row 1: About & Experience side by side -->
    <div class="content-columns">
        <section class="section anim-reveal" id="about">
            <header class="section-header">
                <span class="section-index">[01 // about]</span>
            </header>
            <div class="about-text">
                <p>I build AI-powered developer tools and have shipped 80+ games across PC, console, VR, and mobile. I also lecture on game programming and mentor startups. Based in the Canary Islands. <a href="/about/">More about me →</a></p>
            </div>
        </section>

        <section class="section anim-reveal" id="work">
            <header class="section-header">
                <span class="section-index">[02 // selected work]</span>
            </header>
            <div class="work-timeline">
                <div class="work-entry work-entry--current" x-data="{ open: false }" :class="open ? 'work-entry--open' : ''">
                    <div class="work-entry-head" @click="open = !open">
                        <span class="work-entry-dot"></span>
                        <span class="work-entry-name">AI Agent Platform</span>
                        <span class="work-entry-year">2025 – Present</span>
                    </div>
                    <div class="work-entry-body" :class="open ? 'work-entry-body--open' : ''">
                        <div class="work-entry-tags">
                            <span>python</span><span>fastapi</span><span>langchain</span>
                        </div>
                        <p class="work-entry-desc">Python, FastAPI, LangChain. Reducing manual workflows through intelligent automation across the development lifecycle.</p>
                    </div>
                </div>
                <div class="work-entry" x-data="{ open: false }" :class="open ? 'work-entry--open' : ''">
                    <div class="work-entry-head" @click="open = !open">
                        <span class="work-entry-dot"></span>
                        <span class="work-entry-name">Gaming Accelerator</span>
                        <span class="work-entry-year">2025</span>
                    </div>
                    <div class="work-entry-body" :class="open ? 'work-entry-body--open' : ''">
                        <div class="work-entry-tags">
                            <span>unity</span><span>mentorship</span><span>strategy</span>
                        </div>
                        <p class="work-entry-desc">Technical mentorship, code reviews, and product strategy for early-stage teams at Exel by Merak.</p>
                    </div>
                </div>
                <div class="work-entry" x-data="{ open: false }" :class="open ? 'work-entry--open' : ''">
                    <div class="work-entry-head" @click="open = !open">
                        <span class="work-entry-dot"></span>
                        <span class="work-entry-name">Aurita Games</span>
                        <span class="work-entry-year">2020 – 2025</span>
                    </div>
                    <div class="work-entry-body" :class="open ? 'work-entry-body--open' : ''">
                        <div class="work-entry-tags">
                            <span>unity</span><span>defold</span><span>leadership</span>
                        </div>
                        <p class="work-entry-desc">Transitioned from freelance work to a small company. Design, development, and client relationships across web, PC, and mobile.</p>
                    </div>
                </div>
                <div class="work-entry work-entry--current" x-data="{ open: false }" :class="open ? 'work-entry--open' : ''">
                    <div class="work-entry-head" @click="open = !open">
                        <span class="work-entry-dot"></span>
                        <span class="work-entry-name">PlayMedusa</span>
                        <span class="work-entry-year">2011 – Present</span>
                    </div>
                    <div class="work-entry-body" :class="open ? 'work-entry-body--open' : ''">
                        <div class="work-entry-tags">
                            <span>unity</span><span>c#</span><span>vr</span><span>steam</span>
                        </div>
                        <p class="work-entry-desc">Programming, design, and client work for Steam, Meta Quest, Nintendo Switch, and iOS.</p>
                    </div>
                </div>
                <div class="work-entry" x-data="{ open: false }" :class="open ? 'work-entry--open' : ''">
                    <div class="work-entry-head" @click="open = !open">
                        <span class="work-entry-dot"></span>
                        <span class="work-entry-name">30 Parallel Games</span>
                        <span class="work-entry-year">2018 – 2020</span>
                    </div>
                    <div class="work-entry-body" :class="open ? 'work-entry-body--open' : ''">
                        <div class="work-entry-tags">
                            <span>unity</span><span>photon</span><span>vr</span>
                        </div>
                        <p class="work-entry-desc">Decentralized backends and immersive networked experiences for room-scale VR applications.</p>
                    </div>
                </div>
                <div class="work-entry" x-data="{ open: false }" :class="open ? 'work-entry--open' : ''">
                    <div class="work-entry-head" @click="open = !open">
                        <span class="work-entry-dot"></span>
                        <span class="work-entry-name">Barbie™ Mobile Games</span>
                        <span class="work-entry-year">2017</span>
                    </div>
                    <div class="work-entry-body" :class="open ? 'work-entry-body--open' : ''">
                        <div class="work-entry-tags">
                            <span>unity</span><span>mobile</span><span>leadership</span>
                        </div>
                        <p class="work-entry-desc">Shipped titles that crossed 10 million downloads worldwide across iOS and Android.</p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="content-body" x-data="observation">
        <div class="artifact anim-reveal">
            <span class="artifact-label" x-text="label"></span>
            <p class="artifact-text" x-html="text"></p>
        </div>
    </div>

    <!-- Row 3: Notes -->
    <div class="content-body">
        <section class="section anim-reveal" id="notes">
            <div class="posts-list">
                {%- set latestPosts = collections._posts | sortBy('date', true) %}
                {%- for post in latestPosts %}
                {%- if loop.index0 < 6 %}
                <a href="{{ post.url }}" class="post-row">
                    <span class="post-row-title">{{ post.data.title }}</span>
                    <span class="post-row-tags">
                        {%- for tag in post.data.tags | filterPrivateTags %}
                        <span class="post-row-tag">{{ tag }}</span>
                        {%- endfor %}
                    </span>
                </a>
                {%- endif %}
                {%- endfor %}
            </div>
            <a href="/writing/" class="posts-more">→ browse all notes ({{ collections._posts | languageFilter | length }})</a>
        </section>
    </div>

</div>
<!-- end page-container -->

<!-- Row 4: Bento Grid (full-width) -->
<section class="section anim-reveal" id="stats" style="padding-top:var(--space-xl)">
        <div class="bento-grid">
                <div class="bento-cell">
                    <span class="bento-number">14+</span>
                    <span class="bento-label">years coding</span>
                    <span class="bento-number" style="margin-top:var(--space-2xs)">80+</span>
                    <span class="bento-label">games published</span>
                </div>
                <div class="bento-cell bento-cell--cat bento-cell--tall">
                    <img src="/assets/img/cats.jpg" alt="Marvel &amp; Haru" loading="lazy" eleventy:ignore>
                </div>
                <div class="bento-cell">
                    <strong class="bento-cell-heading">Currently</strong>
                    <div class="bento-tags">
                        <span class="bento-tag">python</span>
                        <span class="bento-tag">fastapi</span>
                        <span class="bento-tag">langchain</span>
                        <span class="bento-tag">git</span>
                        <span class="bento-tag">picotron</span>
                    </div>
                </div>
                <div class="bento-cell">
                    <strong class="bento-cell-heading">Previously</strong>
                    <div class="bento-tags">
                        <span class="bento-tag bento-tag--muted">c#</span>
                        <span class="bento-tag bento-tag--muted">javascript</span>
                        <span class="bento-tag bento-tag--muted">node.js</span>
                        <span class="bento-tag bento-tag--muted">lua</span>
                        <span class="bento-tag bento-tag--muted">solidity</span>
                        <span class="bento-tag bento-tag--muted">hardhat</span>
                        <span class="bento-tag bento-tag--muted">unreal</span>
                        <span class="bento-tag bento-tag--muted">defold</span>
                        <span class="bento-tag bento-tag--muted">unity3d</span>
                        <span class="bento-tag bento-tag--muted">rider</span>
                    </div>
                </div>
                <div class="bento-cell">
                    <strong class="bento-cell-heading">Toolbox</strong>
                    <div class="bento-tags">
                        <span class="bento-tag">neovim</span>
                        <span class="bento-tag">ghostty</span>
                        <span class="bento-tag">obsidian</span>
                        <span class="bento-tag">omarchy</span>
                        <span class="bento-tag">osx</span>
                        <span class="bento-tag">zen</span>
                        <span class="bento-tag">gopass</span>
                        <span class="bento-tag">lazydocker</span>
                        <span class="bento-tag">lazygit</span>
                    </div>
                </div>
            </div>
</section>

<!-- Scroll Reveals -->
<script>
(function() {
    requestAnimationFrame(function() {
        requestAnimationFrame(function() {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                    }
                });
            }, { threshold: 0.05 });

            document.querySelectorAll('.anim-reveal').forEach(function(el) {
                observer.observe(el);
            });
        });
    });
})();
</script>

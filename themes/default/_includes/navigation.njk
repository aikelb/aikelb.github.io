<nav class="navigation">
    <a class="site-logo" href="/">Aitor Lozano</a>
    <ul class="navigation-menu">
        {% for item in navigation[page.lang] %}
        {%- set url = item.url | locale_url %}
        <li>
            <a 
                href="{{ url }}"
                {% if page.url === url %}aria-current="page"{% endif %}
            >
                {{ item.text }}
            </a>
        </li>
        {%- endfor %}
    </ul>
</nav>
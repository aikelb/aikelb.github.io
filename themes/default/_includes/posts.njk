{% for post in postslist %}
    {%- set itemTags = post.data.tags | filterPrivateTags | join(' ') -%}
    <li class="postlist-item{% if post.url === url %} postlist-item-active{% endif %}" data-tags="{{ itemTags }}" :class="{ 'postlist-item--hidden': (notesFilter ?? 'all') !== 'all' && !$el.dataset.tags.split(' ').includes(notesFilter) }">
        <div class="postlist-item-inner">
            <a href="{{ post.url }}" class="postlist-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
            <span class="postlist-meta">
                {%- for tag in post.data.tags | filterPrivateTags %}
                <span class="postlist-tag">{{ tag }}</span>
                {%- endfor %}
                <time datetime="{{ post.date | dateToRfc3339 }}">{{ post.date | formatDate({ year: 'numeric', month: 'short' }) }}</time>
                {%- if post.data.slides %}
                <svg class="postlist-type" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Slide deck"><title>Slide deck</title><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg>
                {%- endif %}
                {%- if post.data.tool %}
                <svg class="postlist-type" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Interactive tool"><title>Interactive tool</title><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4Z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                {%- endif %}
            </span>
        </div>
    </li>
{% endfor %}

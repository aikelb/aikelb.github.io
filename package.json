{
  "name": "aitorlozano.com",
  "version": "1.0.0",
  "description": "Personal portfolio of Aitor Lozano, built with 11ty (based on the Elva starter theme)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "rimraf dist && npx @11ty/eleventy",
    "build:prod": "export NODE_ENV=production && rimraf dist && npx @11ty/eleventy",
    "build:stage": "export NODE_ENV=staging && rimraf dist && npx @11ty/eleventy",
    "dev": "npx @11ty/eleventy --watch --serve --incremental",
    "start": "rimraf dist && npx @11ty/eleventy --serve",
    "clean": "rimraf dist",
    "debug": "DEBUG=Eleventy* npm run dev",
    "benchmark": "DEBUG=Eleventy:Benchmark* npm run build:prod",
    "test": "vitest run"
  },
  "bugs": {
    "url": "https://github.com/aikelb/elva/issues"
  },
  "keywords": [
    "eleventy",
    "11ty",
    "starter",
    "theme",
    "i18n",
    "rss",
    "markdown",
    "sitemaps",
    "CSS",
    "alpine"
  ],
  "author": {
    "name": "Aitor Lozano",
    "url": "https://aitorlozano.com",
    "email": "info@aitorlozano.com"
  },
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "3.1.5",
    "@11ty/eleventy-fetch": "^5.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@alpinejs/intersect": "^3.15.11",
    "@sindresorhus/slugify": "^2.2.1",
    "alpinejs": "^3.15.11",
    "browserslist": "^4.28.2",
    "cheerio": "^1.2.0",
    "eleventy-plugin-embed-everything": "^1.21.2",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.32.0",
    "lodash.get": "^4.4.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "mime-types": "^3.0.2",
    "node-html-to-image": "^5.0.0",
    "nunjucks": "^3.2.4",
    "rimraf": "^6.1.3",
    "terser": "^5.46.1"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}

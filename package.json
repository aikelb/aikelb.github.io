{
  "name": "aitorlozano.com",
  "version": "1.0.0",
  "description": "Personal portfolio of Aitor Lozano, built with 11ty (based on the Elva starter theme)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm run clean && eleventy",
    "build:prod": "export NODE_ENV=production && pnpm run clean && eleventy",
    "build:stage": "export NODE_ENV=staging && pnpm run clean && eleventy",
    "dev": "eleventy --watch --serve --incremental",
    "start": "pnpm run clean && eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "debug": "DEBUG=Eleventy* pnpm run dev",
    "benchmark": "DEBUG=Eleventy:Benchmark* pnpm run build:prod",
    "test": "vitest run"
  },
  "bugs": {
    "url": "https://github.com/aikelb/elva/issues"
  },
  "keywords": [
    "eleventy",
    "11ty",
    "starter",
    "theme",
    "i18n",
    "rss",
    "markdown",
    "sitemaps",
    "CSS",
    "alpine"
  ],
  "author": {
    "name": "Aitor Lozano",
    "url": "https://aitorlozano.com",
    "email": "info@aitorlozano.com"
  },
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@alpinejs/intersect": "^3.17.4",
    "@sindresorhus/slugify": "^3.0.1",
    "alpinejs": "^3.17.4",
    "browserslist": "^4.29.3",
    "cheerio": "^1.2.0",
    "eleventy-plugin-embed-everything": "^1.21.2",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "mime-types": "^3.0.2",
    "nunjucks": "^3.2.4",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "node-html-to-image": "^6.2.0",
    "vitest": "^5.0.4"
  }
}
